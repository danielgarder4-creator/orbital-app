# ──────────────────────────────────────────────────────────────
# ORBITAL — Environment Variables
# Copy this file to `.env` and fill in real values.
# Never commit `.env` — only `.env.example` is checked in.
# ──────────────────────────────────────────────────────────────

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (PostgreSQL / Prisma) ---
DATABASE_URL="postgresql://user:password@localhost:5432/orbital"

# --- Auth (NextAuth.js v5) ---
AUTH_SECRET=""                 # generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe ---
# Required for real subscription billing. If unset, the app runs in
# DEMO_BILLING mode: pricing/checkout UI works, but no real charges
# are made and subscription state is simulated. See lib/stripe/README.md
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""         # price_xxx for the €60/mo "AI Pro" plan

# --- AI Provider ---
# Orbital's AI layer (lib/ai/service.ts) is provider-agnostic.
# If unset, the app runs in DEMO_AI mode: every AI feature responds
# with realistic, clearly-labeled mock output instead of live calls.
ANTHROPIC_API_KEY=""
AI_PROVIDER="anthropic"        # anthropic | openai | mock

# --- Image Generation ---
# Used by the AI Creative Studio for background swaps / lifestyle shots.
IMAGE_PROVIDER=""               # e.g. "stability" | "openai" | "mock"
IMAGE_PROVIDER_API_KEY=""

# --- Transactional Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Orbital <hello@orbital.app>"

# --- Object Storage (product photos, generated creatives) ---
STORAGE_PROVIDER=""             # e.g. "s3" | "r2" | "local"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION=""
